generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  passwordHash String?
  role      String   @default("CITIZEN") // e.g., CITIZEN, OPERATOR, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incidents Incident[]
}

model Incident {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("NEW") // NEW, ACTIVE, RESOLVED
  locationLat Float?
  locationLng Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  type          String   @default("OTHER")
  victimCount   Int?
  elderlyCount  Int?
  childrenCount Int?
  disabledCount Int?
  waterLevel    Float?
  rainfall      Float?
  roadAccess    String?

  reporterId String?
  reporter   User?   @relation(fields: [reporterId], references: [id])

  reports       IncidentReport[]
  predictions   Prediction[]
  dispatchPlans DispatchPlan[]
  outcomes      IncidentOutcome[]
  meshMessages  MeshMessage[]
  roads         Road[]
}

model IncidentReport {
  id          String   @id @default(uuid())
  content     String
  createdAt   DateTime @default(now())
  
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id])
}

model Resource {
  id        String   @id @default(uuid())
  type      String   // AMBULANCE, RESCUE_TEAM
  status    String   @default("AVAILABLE") // AVAILABLE, DISPATCHED, MAINTENANCE
  name      String
  locationLat Float?
  locationLng Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ambulances   Ambulance[]
  rescueTeams  RescueTeam[]
}

model Ambulance {
  id          String   @id @default(uuid())
  plateNumber String @unique
  resourceId  String
  resource    Resource @relation(fields: [resourceId], references: [id])
}

model RescueTeam {
  id         String   @id @default(uuid())
  personnel  Int
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id])
}

model Hospital {
  id          String   @id @default(uuid())
  name        String
  locationLat Float?
  locationLng Float?

  capacities  HospitalCapacity[]
}

model HospitalCapacity {
  id         String   @id @default(uuid())
  totalBeds  Int
  available  Int
  updatedAt  DateTime @updatedAt
  
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
}

model Road {
  id          String   @id @default(uuid())
  name        String
  status      String   @default("OPEN") // OPEN, BLOCKED, HAZARDOUS
  updatedAt   DateTime @updatedAt

  incidentId  String?
  incident    Incident? @relation(fields: [incidentId], references: [id])
}

model WeatherObservation {
  id          String   @id @default(uuid())
  locationLat Float
  locationLng Float
  rainfallMm  Float
  timestamp   DateTime @default(now())

  predictions Prediction[]
}

model WaterLevel {
  id          String   @id @default(uuid())
  locationLat Float
  locationLng Float
  levelMeters Float
  timestamp   DateTime @default(now())

  predictions Prediction[]
}

model Prediction {
  id                   String   @id @default(uuid())
  predictedRisk        Float
  predictedWorsening   Boolean
  timestamp            DateTime @default(now())

  incidentId           String?
  incident             Incident? @relation(fields: [incidentId], references: [id])
  weatherObservationId String?
  weatherObservation   WeatherObservation? @relation(fields: [weatherObservationId], references: [id])
  waterLevelId         String?
  waterLevel           WaterLevel? @relation(fields: [waterLevelId], references: [id])
}

model DispatchPlan {
  id          String   @id @default(uuid())
  status      String   @default("PENDING") // PENDING, APPROVED, EXECUTED, CANCELLED
  details     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id])
}

model IncidentOutcome {
  id          String   @id @default(uuid())
  resolution  String
  feedback    String?
  createdAt   DateTime @default(now())

  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id])
}

model MeshMessage {
  id          String   @id @default(uuid())
  payload     String
  senderId    String
  receivedAt  DateTime @default(now())

  incidentId  String?
  incident    Incident? @relation(fields: [incidentId], references: [id])
}
